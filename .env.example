# Local Docker Compose defaults. Copy to .env for local overrides.

POSTGRES_DB=stockball
POSTGRES_USER=stockball
POSTGRES_PASSWORD=stockball
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
ADMIN_UI_PORT=3001
TRADING_ENGINE_PORT=3000

STOCKBALL_API_DATABASE_URL=postgresql://stockball:stockball@postgres:5432/stockball
STOCKBALL_API_TRADING_ENGINE_URL=http://trading-engine:3000
STOCKBALL_API_REDIS_URL=redis://redis:6379/0
STOCKBALL_DEV_PORTAL_ENABLED=true
NEXT_PUBLIC_STOCKBALL_API_URL=http://localhost:8000

STOCKBALL_TRADING_ENGINE_DATABASE_URL=postgresql://stockball:stockball@postgres:5432/stockball
STOCKBALL_TRADING_ENGINE_BIND_ADDR=0.0.0.0:3000

STOCKBALL_WORKER_DATABASE_URL=postgresql://stockball:stockball@postgres:5432/stockball
STOCKBALL_WORKER_REDIS_URL=redis://redis:6379/0
STOCKBALL_WORKER_API_URL=http://api:8000
STOCKBALL_WORKER_TRADING_ENGINE_URL=http://trading-engine:3000
STOCKBALL_WORKER_LOG_LEVEL=INFO
STOCKBALL_WORKER_SCHEDULER_POLL_SECONDS=60
STOCKBALL_WORKER_BLOCK_SECONDS=5
STOCKBALL_WORKER_RETRY_DELAY_SECONDS=30
STOCKBALL_WORKER_MAX_ATTEMPTS=5
MARKET_VALUES_DIR=./services/worker/app/ingestion/market_values/archive (1)

# Optional FBref ingestion settings for players, fixtures, and player stats.
# Use a clear user agent with a real project/contact before live ingestion.
STOCKBALL_FBREF_BASE_URL=https://fbref.com
STOCKBALL_FBREF_USER_AGENT=StockballMarketWorker/0.1;contact=engineering@stockball.local;provider=FBREF
STOCKBALL_FBREF_REQUEST_INTERVAL_SECONDS=6.5
STOCKBALL_FBREF_CACHE_TTL_SECONDS=86400

# Bet365 ingestion always uses rendered browser navigation and is opt-in.
# Enable it only after explicitly acknowledging the deployment's access policy.
STOCKBALL_BET365_SCHEDULE_ENABLED=false
STOCKBALL_BET365_LIVE_SCHEDULE_ENABLED=false
STOCKBALL_BET365_LIVE_SCHEDULE_INTERVAL_MINUTES=1
STOCKBALL_BET365_LIVE_EVENT_WINDOW_MINUTES=180
STOCKBALL_BET365_WEBSITE_URL=https://www.bet365.com/#/HO/
STOCKBALL_BET365_WEBSITE_NAVIGATION_INTERVAL_SECONDS=5
STOCKBALL_BET365_COMPETITION_NAME=Premier League
STOCKBALL_BET365_MAX_MATCHES=20
STOCKBALL_BET365_PRE_MATCH_CUTOFF_MINUTES=5
STOCKBALL_BET365_BROWSER_ENABLED=false
STOCKBALL_BET365_BROWSER_IDLE_SECONDS=0.3
# Worker ingestion uses an isolated temporary Chrome profile.

# Daily FBref player-stat refresh. A missed UTC window runs when the scheduler resumes.
STOCKBALL_PLAYER_STATS_SCHEDULE_ENABLED=true
STOCKBALL_PLAYER_STATS_SCHEDULE_HOUR_UTC=3
STOCKBALL_PLAYER_STATS_SCHEDULE_LEAGUE=9
STOCKBALL_PLAYER_STATS_SCHEDULE_SEASON=2025

# Optional Twitter injury intelligence. This uses only GET /2/tweets/search/recent.
# Keep disabled until the X developer use case and health/off-X matching policies
# have been reviewed and explicitly approved for this deployment.
STOCKBALL_TWITTER_BEARER_TOKEN=
STOCKBALL_TWITTER_SEARCH_QUERY=
STOCKBALL_TWITTER_QUERY_KEY=
STOCKBALL_TWITTER_POLICY_ACKNOWLEDGED=false
STOCKBALL_TWITTER_REQUEST_INTERVAL_SECONDS=1
STOCKBALL_TWITTER_MAX_RATE_LIMIT_SLEEP_SECONDS=60
STOCKBALL_TWITTER_MAX_RESULTS=100
STOCKBALL_TWITTER_MAX_PAGES_PER_POLL=10
STOCKBALL_TWITTER_INJURY_SCHEDULE_ENABLED=false
STOCKBALL_TWITTER_INJURY_SCHEDULE_INTERVAL_MINUTES=5
STOCKBALL_TWITTER_BROWSER_ENABLED=false
# Chrome root directory, not the profile directory itself.
STOCKBALL_TWITTER_BROWSER_USER_DATA_DIR=
# Example: Default or Profile 1. Requires STOCKBALL_TWITTER_BROWSER_USER_DATA_DIR.
STOCKBALL_TWITTER_BROWSER_PROFILE_DIRECTORY=
