{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockball.local/schemas/trading.schema.json",
  "title": "Stockball Trading Schemas",
  "type": "object",
  "$defs": {
    "Instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "instrument_type",
        "player_id",
        "symbol",
        "display_name",
        "current_price",
        "reference_price",
        "quantity_outstanding",
        "net_shares_purchased",
        "full_supply_price_multiplier",
        "curve_depth_shares",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "instrument_type": {
          "$ref": "./common.schema.json#/$defs/InstrumentType"
        },
        "player_id": {
          "$ref": "./common.schema.json#/$defs/Uuid",
          "description": "Linked player for PLAYER_SHARE instruments."
        },
        "symbol": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "current_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "reference_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString",
          "description": "Price quoted when cumulative net buying pressure is zero."
        },
        "quantity_outstanding": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "net_shares_purchased": {
          "$ref": "./common.schema.json#/$defs/DecimalString",
          "description": "Shares bought through the engine minus shares sold through it since the curve was last anchored."
        },
        "full_supply_price_multiplier": {
          "$ref": "./common.schema.json#/$defs/DecimalString",
          "description": "Price multiplier reached when net buying equals curve_depth_shares."
        },
        "curve_depth_shares": {
          "$ref": "./common.schema.json#/$defs/DecimalString",
          "description": "Net shares that carry the price to full_supply_price_multiplier times the reference price; a fraction of the supply."
        },
        "status": {
          "$ref": "./common.schema.json#/$defs/InstrumentStatus"
        },
        "created_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "Portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "account_id", "cash_balance", "created_at", "updated_at"],
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "account_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "cash_balance": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "created_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "portfolio_id",
        "instrument_id",
        "quantity",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "portfolio_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "quantity": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "created_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "Order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "request_id",
        "account_id",
        "portfolio_id",
        "instrument_id",
        "side",
        "quantity",
        "status",
        "submitted_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "request_id": {
          "type": "string",
          "description": "Caller-provided idempotency key for retry-safe order execution."
        },
        "account_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "portfolio_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "side": {
          "$ref": "./common.schema.json#/$defs/OrderSide"
        },
        "quantity": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "status": {
          "$ref": "./common.schema.json#/$defs/OrderStatus"
        },
        "rejection_reason": {
          "type": ["string", "null"]
        },
        "submitted_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        },
        "filled_at": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "Trade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order_id",
        "account_id",
        "portfolio_id",
        "instrument_id",
        "side",
        "quantity",
        "execution_price",
        "gross_amount",
        "executed_at"
      ],
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "order_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "account_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "portfolio_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "side": {
          "$ref": "./common.schema.json#/$defs/OrderSide"
        },
        "quantity": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "execution_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "gross_amount": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "executed_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "CashLedgerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "account_id",
        "portfolio_id",
        "reason",
        "amount_delta",
        "balance_after",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "account_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "portfolio_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "trade_id": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "./common.schema.json#/$defs/LedgerReason"
        },
        "amount_delta": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "balance_after": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "source_request_id": {
          "type": ["string", "null"]
        },
        "created_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "PriceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "instrument_id",
        "old_price",
        "new_price",
        "reason",
        "captured_at"
      ],
      "properties": {
        "id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "old_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "new_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "reason": {
          "$ref": "./common.schema.json#/$defs/PriceSnapshotReason"
        },
        "trade_id": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "ApplyTopupRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "account_id", "portfolio_id", "amount", "reason"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "account_id": { "$ref": "./common.schema.json#/$defs/Uuid" },
        "portfolio_id": { "$ref": "./common.schema.json#/$defs/Uuid" },
        "amount": {
          "allOf": [
            { "$ref": "./common.schema.json#/$defs/DecimalString" },
            { "pattern": "^(?!(?:0(?:\\.0+)?)$)(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
          ]
        },
        "reason": { "$ref": "./common.schema.json#/$defs/LedgerReason" }
      }
    },
    "ExecuteOrderRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "account_id",
        "portfolio_id",
        "instrument_id",
        "side",
        "quantity"
      ],
      "properties": {
        "execution_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_price", "expected_cash_balance", "max_gross_amount"],
          "properties": {
            "expected_price": {"$ref": "./common.schema.json#/$defs/DecimalString"},
            "expected_cash_balance": {"$ref": "./common.schema.json#/$defs/DecimalString"},
            "max_gross_amount": {"$ref": "./common.schema.json#/$defs/DecimalString"}
          },
          "description": "Optional execution-time quote preconditions checked atomically before any trade."
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "Caller-provided idempotency key for retry-safe order execution."
        },
        "account_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "portfolio_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "side": {
          "$ref": "./common.schema.json#/$defs/OrderSide"
        },
        "quantity": {
          "allOf": [
            {
              "$ref": "./common.schema.json#/$defs/DecimalString"
            },
            {
              "pattern": "^(?!(?:0(?:\\.0+)?)$)(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          ],
          "description": "Positive instrument quantity encoded as a decimal string."
        }
      }
    },
    "ExecuteOrderResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "order_id",
        "trade_id",
        "account_id",
        "portfolio_id",
        "instrument_id",
        "side",
        "quantity",
        "execution_price",
        "gross_amount",
        "cash_balance_after",
        "position_quantity_after",
        "old_price",
        "new_price",
        "executed_at"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "order_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "trade_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "account_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "portfolio_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "side": {
          "$ref": "./common.schema.json#/$defs/OrderSide"
        },
        "quantity": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "execution_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "gross_amount": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "cash_balance_after": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "position_quantity_after": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "old_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "new_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "executed_at": {
          "$ref": "./common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "OrderQuoteResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "portfolio_id",
        "instrument_id",
        "side",
        "quantity",
        "execution_price",
        "gross_amount",
        "cash_balance_after",
        "position_quantity_after",
        "old_price",
        "new_price",
        "quoted_at"
      ],
      "properties": {
        "account_id": { "$ref": "./common.schema.json#/$defs/Uuid" },
        "portfolio_id": { "$ref": "./common.schema.json#/$defs/Uuid" },
        "instrument_id": { "$ref": "./common.schema.json#/$defs/Uuid" },
        "side": { "$ref": "./common.schema.json#/$defs/OrderSide" },
        "quantity": { "$ref": "./common.schema.json#/$defs/DecimalString" },
        "execution_price": { "$ref": "./common.schema.json#/$defs/DecimalString" },
        "gross_amount": { "$ref": "./common.schema.json#/$defs/DecimalString" },
        "cash_balance_after": { "$ref": "./common.schema.json#/$defs/DecimalString" },
        "position_quantity_after": { "$ref": "./common.schema.json#/$defs/DecimalString" },
        "old_price": { "$ref": "./common.schema.json#/$defs/DecimalString" },
        "new_price": { "$ref": "./common.schema.json#/$defs/DecimalString" },
        "quoted_at": { "$ref": "./common.schema.json#/$defs/Timestamp" }
      }
    },
    "SeedPlayerSharesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_count",
        "skipped_existing_count",
        "market_value_priced_count",
        "fallback_priced_count",
        "created_instrument_ids"
      ],
      "properties": {
        "created_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_existing_count": {
          "type": "integer",
          "minimum": 0
        },
        "market_value_priced_count": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_priced_count": {
          "type": "integer",
          "minimum": 0
        },
        "created_instrument_ids": {
          "type": "array",
          "items": {
            "$ref": "./common.schema.json#/$defs/Uuid"
          }
        }
      }
    },
    "ApplyOpeningBalanceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "account_id",
        "portfolio_id",
        "amount"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "account_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "portfolio_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "amount": {
          "allOf": [
            {
              "$ref": "./common.schema.json#/$defs/DecimalString"
            },
            {
              "pattern": "^(?!(?:0(?:\\.0+)?)$)(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          ]
        }
      }
    },
    "InitialSupplyAllocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "portfolio_id",
        "quantity"
      ],
      "properties": {
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "portfolio_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "quantity": {
          "allOf": [
            {
              "$ref": "./common.schema.json#/$defs/DecimalString"
            },
            {
              "pattern": "^(?!(?:0(?:\\.0+)?)$)(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          ]
        }
      }
    },
    "IssueInitialSupplyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "allocations"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/InitialSupplyAllocation"
          }
        }
      }
    },
    "IssueInitialSupplyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "instrument_count",
        "position_count"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument_count": {
          "type": "integer",
          "minimum": 1
        },
        "position_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "SetPreMarketPriceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "instrument_id",
        "new_price"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "new_price": {
          "allOf": [
            {
              "$ref": "./common.schema.json#/$defs/DecimalString"
            },
            {
              "pattern": "^(?!(?:0(?:\\.0+)?)$)(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          ]
        }
      }
    },
    "PreMarketPriceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "old_price",
        "new_price"
      ],
      "properties": {
        "instrument_id": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "old_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "new_price": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        }
      }
    },
    "RecalibratePriceCurvesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "full_supply_price_multiplier",
        "curve_depth_divisor",
        "reason"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "full_supply_price_multiplier": {
          "description": "Price multiple reached at the end of each curve; greater than 1.",
          "allOf": [
            {
              "$ref": "./common.schema.json#/$defs/DecimalString"
            },
            {
              "pattern": "^(?!(?:0(?:\\.0+)?)$)(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          ]
        },
        "curve_depth_divisor": {
          "description": "Each curve spans shares_outstanding divided by this; at least 1.",
          "allOf": [
            {
              "$ref": "./common.schema.json#/$defs/DecimalString"
            },
            {
              "pattern": "^(?!(?:0(?:\\.0+)?)$)(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "type": "boolean",
          "default": false,
          "description": "Apply and report the recalibration, then roll it back. A dry run leaves request_id unused."
        }
      }
    },
    "RecalibratePriceCurvesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "dry_run",
        "full_supply_price_multiplier",
        "curve_depth_divisor",
        "instrument_count",
        "reset_net_demand_count",
        "max_reset_demand_ratio",
        "previous_min_multiplier",
        "previous_max_multiplier"
      ],
      "properties": {
        "request_id": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "full_supply_price_multiplier": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "curve_depth_divisor": {
          "$ref": "./common.schema.json#/$defs/DecimalString"
        },
        "instrument_count": {
          "type": "integer",
          "minimum": 0
        },
        "reset_net_demand_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Instruments whose net demand was folded into their new reference price."
        },
        "max_reset_demand_ratio": {
          "$ref": "./common.schema.json#/$defs/DecimalString",
          "description": "Largest net demand reset, as a share of its old curve depth."
        },
        "previous_min_multiplier": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_max_multiplier": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/DecimalString"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ApplyFreezeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "source_key",
        "instrument_ids"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "MATCH_DAY",
            "ADMIN_HALT",
            "DATA_ISSUE"
          ]
        },
        "source_key": {
          "type": "string",
          "minLength": 1
        },
        "instrument_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "./common.schema.json#/$defs/Uuid"
          }
        }
      }
    },
    "ApplyFreezeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_key",
        "reason",
        "opened_count",
