# Optional overrides for scripts/local-ingestion.sh.
# Copy this file to .env.local-ingestion and edit as needed.

POSTGRES_DB=stockball
POSTGRES_USER=stockball
POSTGRES_PASSWORD=stockball
POSTGRES_PORT=5432
REDIS_PORT=6379
TRADING_ENGINE_PORT=3000

# Local path used by the market-values command.
MARKET_VALUES_DIR="./services/worker/app/ingestion/market_values/archive (1)"

# Local virtualenv used by scripts/local-ingestion.sh setup.
LOCAL_WORKER_VENV=.venv-worker

# Reinstall the worker package into the venv on the next run.
LOCAL_INGESTION_REINSTALL=0

# Set to 1 if FBref browser fallback needs a local chromedriver install.
LOCAL_INGESTION_INSTALL_CHROMEDRIVER=0

# Used when the script adds --season for FBref one-off commands.
STOCKBALL_INGESTION_SEASON=2025

# Worker service URLs point at local host services.
STOCKBALL_WORKER_DATABASE_URL=postgresql://stockball:stockball@localhost:5432/stockball?gssencmode=disable
STOCKBALL_WORKER_REDIS_URL=redis://localhost:6379/0
STOCKBALL_WORKER_TRADING_ENGINE_URL=http://localhost:3000
STOCKBALL_WORKER_LOG_LEVEL=INFO

# Use a real project/contact before running live FBref ingestion.
STOCKBALL_FBREF_BASE_URL=https://fbref.com
STOCKBALL_FBREF_USER_AGENT="StockballMarketWorker/0.1;contact=engineering@stockball.local;provider=FBREF"
STOCKBALL_FBREF_REQUEST_INTERVAL_SECONDS=7.5
STOCKBALL_FBREF_CACHE_TTL_SECONDS=86400
